<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Permission-request history belongs to this installation, not another device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
